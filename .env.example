# Copie para .env (que fica fora do Git) e preencha só na sua máquina.

# Etapa 03: liga a ponte app -> issue no GitHub. Vazio = desligado.
AGENT_RUNTIME=github-native
# Mantenha true até o ensaio: o controlador no Actions não faz a atribuição paga ao Copilot.
AGENT_DRY_RUN=true
GITHUB_REPO=gabiberling/App-Fluxo-Tarefas
# Credencial LOCAL do backend: token fine-grained só deste repositório, com Issues (leitura e escrita).
# Não é o COPILOT_AGENT_TOKEN, que fica apenas nos secrets do Actions.
GITHUB_ISSUES_TOKEN=
